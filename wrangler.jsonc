{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perfectpodcast",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./prototype",
    "binding": "ASSETS",
    "run_worker_first": ["/signal/*", "/auth/*", "/turn-test/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomSignaling"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "SIGNAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomSignaling"]
    }
  ]
}
